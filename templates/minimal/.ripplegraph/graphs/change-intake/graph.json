{
  "id": "change-intake",
  "version": "0.4.0",
  "kind": "workflow",
  "title": "Change Intake",
  "description": "Classify a codebase change request, pause for human routing approval, then branch into the right planning task.",
  "activationHints": [
    "triage a change request",
    "review a bugfix feature refactor or question"
  ],
  "effects": [
    "read_repo"
  ],
  "entry": "classify-change",
  "nodes": {
    "classify-change": {
      "purpose": "Classify the queued engineering change",
      "instructions": "Read work-items/inbox.json, engineering-playbook.md, and repo-brief.md. Classify CHG-2042 as bugfix, feature, refactor, or question; choose a risk level; explain the rationale.",
      "exec": "inline",
      "outputSchema": {
        "type": "object",
        "required": ["changeType", "risk", "rationale"],
        "properties": {
          "changeType": { "type": "string", "enum": ["bugfix", "feature", "refactor", "question"] },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "rationale": { "type": "string" }
        }
      },
      "edges": [{ "to": "review-routing" }]
    },
    "review-routing": {
      "purpose": "Human review gate for the routing decision",
      "instructions": "Stop here and ask the user or operator to review the previous classification. Use ripplegraph-demo advance with a decision. Choose approved-bugfix, approved-feature, approved-refactor, or approved-question when accepted, or rejected to route back for reclassification.",
      "exec": "inline",
      "gate": {
        "type": "external_decision",
        "decisionSchema": {
          "type": "object",
          "required": ["decision", "reason"],
          "properties": {
            "decision": {
              "type": "string",
              "enum": ["approved-bugfix", "approved-feature", "approved-refactor", "approved-question", "rejected"]
            },
            "reason": { "type": "string" }
          }
        }
      },
      "edges": [
        { "to": "plan-bugfix", "when": { "decision": "approved-bugfix" } },
        { "to": "shape-feature", "when": { "decision": "approved-feature" } },
        { "to": "simplify-design", "when": { "decision": "approved-refactor" } },
        { "to": "answer-question", "when": { "decision": "approved-question" } },
        { "to": "classify-change", "when": { "decision": "rejected" } }
      ]
    },
    "plan-bugfix": {
      "purpose": "Plan a bugfix",
      "instructions": "Create a concise bugfix plan from CHG-2042 only if the approved route is bugfix. Include reproduction, expected behavior, likely files, and verification.",
      "exec": "inline",
      "outputSchema": {
        "type": "object",
        "required": ["reproduction", "expectedBehavior", "likelyFiles", "verification"],
        "properties": {
          "reproduction": { "type": "string" },
          "expectedBehavior": { "type": "string" },
          "likelyFiles": { "type": "array" },
          "verification": { "type": "array" }
        }
      },
      "edges": [{ "to": "done" }]
    },
    "shape-feature": {
      "purpose": "Shape a feature",
      "instructions": "Turn CHG-2042 into a small feature brief with non-goals and acceptance criteria.",
      "exec": "inline",
      "outputSchema": {
        "type": "object",
        "required": ["summary", "nonGoals", "acceptanceCriteria"],
        "properties": {
          "summary": { "type": "string" },
          "nonGoals": { "type": "array" },
          "acceptanceCriteria": { "type": "array" }
        }
      },
      "edges": [{ "to": "done" }]
    },
    "simplify-design": {
      "purpose": "Plan a behavior-preserving simplification",
      "instructions": "Use CHG-2042 to propose the smallest simplification. Include what behavior must stay unchanged and how to verify it.",
      "exec": "inline",
      "outputSchema": {
        "type": "object",
        "required": ["simplificationTarget", "preservedBehavior", "verification"],
        "properties": {
          "simplificationTarget": { "type": "string" },
          "preservedBehavior": { "type": "array" },
          "verification": { "type": "array" }
        }
      },
      "edges": [{ "to": "done" }]
    },
    "answer-question": {
      "purpose": "Answer an engineering question",
      "instructions": "Answer the request using the local files and state any uncertainty.",
      "exec": "inline",
      "outputSchema": {
        "type": "object",
        "required": ["answer", "confidence", "needsFollowup"],
        "properties": {
          "answer": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "needsFollowup": { "type": "boolean" }
        }
      },
      "edges": [{ "to": "done" }]
    },
    "done": {
      "purpose": "Change intake complete",
      "terminal": true
    }
  }
}
